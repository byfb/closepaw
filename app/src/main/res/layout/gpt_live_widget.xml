<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/gpt_live_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/live_widget_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical"
            android:text="@string/gpt_live_widget_name" android:textSize="19sp" android:textStyle="bold"
            android:textColor="@color/live_widget_ink" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/live_widget_settings" android:layout_width="48dp"
            android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_live_settings" android:background="@android:color/transparent"
            android:contentDescription="@string/gpt_live_widget_settings" />
    </LinearLayout>
    <TextView android:id="@+id/live_widget_status" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp"
        android:gravity="center_vertical" android:text="@string/gpt_live_widget_ready"
        android:textSize="14sp" android:textColor="@color/live_widget_ink" android:maxLines="2"
        android:ellipsize="end" />
    <Button android:id="@+id/live_widget_action" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginTop="8dp"
        android:background="@drawable/gpt_live_widget_button" android:text="@string/gpt_live_widget_start"
        android:textColor="@color/live_widget_on_accent" android:textSize="16sp"
        android:textAllCaps="false" />
</LinearLayout>
